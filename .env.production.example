# ── Copy these into Railway → your service → Variables ──
# (Set the real values in the Railway dashboard, NOT in this file.)

APP_NAME="SH Customer's Analytics"
APP_ENV=production
APP_DEBUG=false
# Generate once locally with:  php artisan key:generate --show
APP_KEY=
# Your Railway URL or custom domain (must include https://)
APP_URL=https://your-app.up.railway.app

# SQLite living on the Railway Volume mounted at /app/database
DB_CONNECTION=sqlite
DB_DATABASE=/app/database/database.sqlite

# Keep sessions/cache/queue in the database so they survive redeploys
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

LOG_CHANNEL=stack
LOG_LEVEL=error
FILESYSTEM_DISK=local
